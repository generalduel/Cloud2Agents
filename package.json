{
  "name": "kit",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "concurrently \"next dev --turbopack\" \"inngest-cli dev -p 8288\" \"email dev --dir ./src/emails --port 3001\"",
    "dev:docker": "concurrently \"next dev --turbopack --hostname 0.0.0.0 -p 3000\" \"inngest-cli dev -p 8288 --host 0.0.0.0 -u http://127.0.0.1:3000/api/inngest\" \"email dev --dir ./src/emails --port 3001\"",
    "docker:dev": "docker compose -f docker/dev/compose.yaml up --build",
    "docker:build": "docker build -f docker/prod/Dockerfile -t indie-kit .",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "script": "tsx --import './scripts/_bootstrap/index.ts'",
    "db:migrate": "tsx --import './scripts/_bootstrap/index.ts' scripts/db-migrate.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push --force",
    "postinstall": "fumadocs-mdx",
    "audit": "pnpm audit --audit-level=high"
  },
