# Razorpay (https://razorpay.com/docs/payments/subscriptions/) — use test-mode keys for dev
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# Same value as RAZORPAY_KEY_ID — exposed to Razorpay Checkout in the browser
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
# Optional: billing cycles before a subscription completes (defaults 120 monthly / 10 yearly)
# RAZORPAY_MONTHLY_TOTAL_COUNT=120
# RAZORPAY_YEARLY_TOTAL_COUNT=10

NEXT_PUBLIC_SIGNIN_ENABLED=false
DODO_PAYMENTS_API_URL="https://live.dodopayments.com" # Or test.dodopayments.com for testing
DODO_PAYMENTS_API_KEY='test_yourkey'

CRON_USERNAME=your_cron_username
CRON_PASSWORD=your_secure_password

NEXT_PUBLIC_COOKIE_CONSENT_ENABLED=true

# PostHog (optional — only loads after analytics consent)
# Project token — public Project API Key (phc_…): frontend events + client feature flags
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# Project secret API key (phs_…) — https://us.posthog.com/project/137763/settings/project-secret-api-keys
POSTHOG_PROJECT_SECRET_API_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Crisp live chat (optional — only loads after support consent)
NEXT_PUBLIC_CRISP_WEBSITE_ID=
